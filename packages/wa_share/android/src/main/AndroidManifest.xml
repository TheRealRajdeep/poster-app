<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: lets us check which WhatsApp apps are installed. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application>
        <!-- Shares files from <cache>/wa_share/ only. Authority is unique per host app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.wa_share.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wa_share_file_paths" />
        </provider>
    </application>
</manifest>
